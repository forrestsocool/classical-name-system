# Random hex values can safely be included in a PostgreSQL URL.
POSTGRES_PASSWORD=
# Used outside Compose; Compose supplies its internal database URL.
DATABASE_URL=postgresql://names:REPLACE_HEX_PASSWORD@127.0.0.1:5432/names
起名管理密钥=
GATEWAY_SECRET=
WECHAT_APP_ID=
USER_REQUESTS_PER_MINUTE=120
起名模型地址=https://api.openai.com/v1/chat/completions
起名模型密钥=
起名模型名称=
PRODUCER_SURNAMES=李,王,张,刘,陈
PRODUCER_DAILY_BATCHES=480
PRODUCER_INTERVAL_SECONDS=10
