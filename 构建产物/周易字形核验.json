    },
    {
      "行": 1341,
      "列": 3,
      "原文片段": "　　干为天，为圆，为君，为父，为玉，为",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1361,
      "列": 2,
      "原文片段": "《干》刚《坤》柔，《比》乐《师》忧；",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1380,
      "列": 46,
      "原文片段": "，一寒一暑，乾道成男，坤道成女。干知大始，坤作成物。干以易知，坤以",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
