    },
    {
      "行": 1276,
      "列": 13,
      "原文片段": "　　干知大始，坤作成物。干以易知，坤以简能；易则易知，简则",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1280,
      "列": 106,
      "原文片段": "新之谓盛德。生生之谓易，成象之谓干，效法之谓坤，极数知来之谓占，通",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1281,
      "列": 41,
      "原文片段": "静而正，以言乎天地之间则备矣。夫干，其静也专，其动也直，是以大生焉",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1293,
      "列": 112,
      "原文片段": "有五，此所以成变化而行鬼神也。《干》之策二百一十有六，《坤》之策百",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1298,
      "列": 219,
      "原文片段": "其德夫。是故阖户谓之坤，辟户谓之干，一阖一辟谓之变，往来不穷谓之通",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1306,
      "列": 118,
      "原文片段": "明者也；天下之动，贞夫一者也。夫干，确然示人易矣；夫坤，𬯎然示人简",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1307,
      "列": 241,
      "原文片段": "、尧、舜垂衣裳而天下治，盖取诸《干》、《坤》。",
      "原字符": "干",
      "建议字符": "乾",
