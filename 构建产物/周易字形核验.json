      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1319,
      "列": 122,
      "原文片段": "子曰：“乾坤，其《易》之门耶？”干，阳物也；坤，阴物也。阴阳合德，",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1326,
      "列": 4,
      "原文片段": "　　夫干，天下之至健也，德行恒易以知险。",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1332,
      "列": 33,
      "原文片段": "，日以烜之，艮以止之，兑以说之，干以君之，坤以藏之。",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1333,
      "列": 29,
      "原文片段": "见乎离，致役乎坤，说言乎兑，战乎干，劳乎坎，成言乎艮。万物出乎震，",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1334,
      "列": 87,
      "原文片段": "物之所说也，故曰：说言乎兑。战乎干，干西北之卦也，言阴阳相薄也。坎",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1334,
      "列": 89,
      "原文片段": "所说也，故曰：说言乎兑。战乎干，干西北之卦也，言阴阳相薄也。坎者水",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "乾卦或乾乾语境"
    },
    {
      "行": 1336,
      "列": 3,
      "原文片段": "　　干，健也。坤，顺也。震，动也。巽，",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1337,
      "列": 3,
      "原文片段": "　　干为马，坤为牛，震为龙，巽为鸡，坎",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1338,
      "列": 3,
      "原文片段": "　　干为首，坤为腹，震为足，巽为股，坎",
      "原字符": "干",
      "建议字符": "乾",
      "置信度": "高",
      "依据": "卦名、卦象或八卦语境"
    },
    {
      "行": 1339,
      "列": 3,
      "原文片段": "　　干，天也，故称乎父。坤，地也，故称",
