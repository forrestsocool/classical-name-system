.profile-page { min-height: calc(100vh - 105rpx); padding: 28rpx 28rpx calc(160rpx + env(safe-area-inset-bottom)); background: #f7f5ee; color: #294740; box-sizing: border-box; }
.profile-panel { margin-bottom: 24rpx; padding: 30rpx; border: 1rpx solid #e8e8df; border-radius: 24rpx; background: #fffefa; box-shadow: 0 10rpx 28rpx rgba(52, 69, 61, .04); }
.section-head { display: flex; align-items: center; min-height: 42rpx; }
.section-icon { flex-shrink: 0; width: 34rpx; height: 34rpx; margin-right: 14rpx; }
.section-title { margin: 0; color: #164f45; font-size: 32rpx; font-weight: 600; letter-spacing: 2rpx; }
.section-caption { margin-left: auto; padding-left: 16rpx; color: #87938b; font-size: 22rpx; }
.character-field { margin-top: 30rpx; }
.field-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; font-size: 27rpx; }
.field-limit { color: #99a198; font-size: 21rpx; }
.character-input { width: 100%; height: 82rpx; padding: 0 23rpx; box-sizing: border-box; border: 1rpx solid #e2e8df; border-radius: 14rpx; color: #174c42; background: #f6f8f2; font-size: 29rpx; }
.input-placeholder { color: #a0a69e; font-size: 26rpx; }
.field-hint { margin-top: 12rpx; color: #87928a; font-size: 22rpx; line-height: 1.6; }
.section-note { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #efeee7; color: #87928a; font-size: 22rpx; line-height: 1.6; }
.input-error { margin-top: 20rpx; color: #b45d49; font-size: 23rpx; line-height: 1.7; }
.source-intro { margin-top: 12rpx; color: #87928a; font-size: 23rpx; }
.source-toolbar { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-bottom: 12rpx; color: #929a91; font-size: 22rpx; border-bottom: 1rpx solid #eaece3; }
.source-tools { display: flex; align-items: center; }
.source-tools button { margin: 0; padding: 0 18rpx; line-height: 54rpx; color: #286857; background: transparent; font-size: 23rpx; }
.source-tools button:last-child { padding-right: 0; }
.source-tools button[disabled] { color: #aeb7ad; }
.source-tools button::after, .profile-button::after, .source-error button::after { border: 0; }
.source-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 6rpx 0; border-bottom: 1rpx solid #f0efe9; box-sizing: border-box; }
.source-row:last-child { border-bottom: 0; }
.source-info { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; padding: 12rpx 20rpx 12rpx 0; }
.source-name { font-size: 28rpx; line-height: 1.5; }
.source-kind { padding: 3rpx 10rpx; border-radius: 6rpx; background: #f0f3eb; color: #929d8c; font-size: 19rpx; line-height: 1.5; }
.source-switch { flex-shrink: 0; transform: scale(.83); transform-origin: right center; }
.source-status, .source-error { padding: 32rpx 0 8rpx; color: #87928a; font-size: 24rpx; line-height: 1.6; }
.source-error button { margin: 18rpx 0 0; color: #216255; background: #edf3e9; font-size: 24rpx; }
.save-notice { min-height: 34rpx; margin-top: 30rpx; color: #87928a; text-align: center; font-size: 22rpx; line-height: 1.6; }
.profile-button { display: flex; align-items: center; justify-content: center; gap: 18rpx; width: 100%; margin: 16rpx 0 32rpx; min-height: 90rpx; border-radius: 18rpx; color: #fffefa; background: #216255; font-size: 29rpx; font-weight: 500; }
.profile-button image { width: 31rpx; height: 31rpx; }
.account-panel { padding-top: 4rpx; padding-bottom: 4rpx; }
.profile-row { min-height: 86rpx; display: flex; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 1rpx solid #eeeee8; font-size: 25rpx; }
.profile-row:last-child { border-bottom: 0; }
.profile-value { color: #6b7e70; }
.profile-openid-row { align-items: flex-start; padding: 24rpx 0; min-height: 0; }
.profile-openid { max-width: 430rpx; font-family: monospace; font-size: 21rpx; line-height: 1.5; text-align: right; word-break: break-all; }
.privacy-row image { width: 28rpx; height: 28rpx; opacity: .65; }
.profile-foot { margin-top: 40rpx; color: #a1a8a4; text-align: center; font-size: 20rpx; line-height: 1.7; }
.profile-version { margin-top: 12rpx; color: #8a978e; text-align: center; font-size: 20rpx; line-height: 1.6; }
