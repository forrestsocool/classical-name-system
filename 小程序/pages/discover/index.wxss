.discover-page {
  --paper: #f6f3eb;
  --card: #fffdf7;
  --ink: #283f34;
  --green: #2d5948;
  --muted: #7a8779;
  --vermillion: #b65c48;
  min-height: calc(100vh - 112rpx);
  padding: 26rpx 32rpx 24rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 7%, rgba(179, 154, 99, .12), transparent 24%),
    linear-gradient(165deg, rgba(255, 253, 247, .35), rgba(229, 231, 215, .22));
}

.masthead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.brand-lockup { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.brand-seal { width: 62rpx; height: 62rpx; border: 2rpx solid var(--vermillion); color: var(--vermillion); display: flex; align-items: center; justify-content: center; font-family: "Songti SC", "STSong", serif; font-size: 23rpx; letter-spacing: 2rpx; transform: rotate(-3deg); border-radius: 7rpx; }
.brand-name { font-family: "Songti SC", "STSong", serif; font-size: 38rpx; font-weight: 700; letter-spacing: 6rpx; color: var(--ink); }
.brand-subtitle { margin-top: 4rpx; color: #839082; font-size: 18rpx; letter-spacing: 2rpx; white-space: nowrap; }

.length-switch { flex: none; display: flex; padding: 5rpx; border: 1rpx solid #d7dacb; border-radius: 999rpx; background: rgba(255, 253, 247, .72); }
.length-option { min-width: 68rpx; padding: 11rpx 10rpx; border-radius: 999rpx; color: #7a8779; text-align: center; font-size: 22rpx; transition: color 180ms ease, background 180ms ease; }
.length-option.is-active { color: #fffdf7; background: var(--green); box-shadow: 0 5rpx 14rpx rgba(45, 89, 72, .2); }

.deck { position: relative; height: 760rpx; margin: 0 7rpx; }
.name-card { position: absolute; left: 0; right: 0; top: 0; height: 700rpx; border-radius: 34rpx 34rpx 28rpx 28rpx; transform-origin: 50% 92%; }
.card-shadow { border: 1rpx solid rgba(62, 82, 67, .1); background: #f4f2e9; pointer-events: none; }
.card-third { top: 31rpx; left: 30rpx; right: 30rpx; opacity: .34; transform: scale(.925); }
.card-next { top: 14rpx; left: 15rpx; right: 15rpx; padding: 32rpx 38rpx; opacity: .55; transform: translateY(14px) scale(.96); transition: transform 180ms ease, opacity 180ms ease; }
.card-current { z-index: 3; display: flex; flex-direction: column; padding: 34rpx 38rpx 27rpx; border: 1rpx solid rgba(75, 94, 77, .15); background:
  linear-gradient(rgba(255, 253, 247, .97), rgba(255, 253, 247, .97)),
  repeating-linear-gradient(0deg, transparent 0, transparent 31rpx, rgba(84, 105, 86, .04) 32rpx);
  box-shadow: 0 22rpx 58rpx rgba(53, 70, 56, .14), 0 3rpx 8rpx rgba(53, 70, 56, .06);
  will-change: transform;
}
.card-current::before { content: ""; position: absolute; left: 18rpx; top: 18rpx; right: 18rpx; bottom: 18rpx; border: 1rpx solid rgba(93, 113, 94, .08); border-radius: 24rpx; pointer-events: none; }
.card-heading { display: flex; justify-content: space-between; align-items: baseline; position: relative; z-index: 1; }
.card-kicker { color: #8b967f; font-size: 19rpx; letter-spacing: 5rpx; }
.book-label { max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #758170; font-size: 22rpx; }
.next-name { margin-top: 70rpx; text-align: center; color: rgba(45, 75, 58, .3); font: 600 60rpx/1.2 "Songti SC", "STSong", serif; letter-spacing: 12rpx; }

.name-block { padding: 57rpx 0 35rpx; text-align: center; }
.candidate-name { color: var(--ink); font: 700 98rpx/1.1 "Songti SC", "STSong", serif; letter-spacing: 18rpx; text-indent: 18rpx; }
.candidate-pinyin { margin-top: 14rpx; color: #8a9483; font-size: 22rpx; letter-spacing: 6rpx; text-transform: lowercase; }
.ink-rule { position: relative; height: 1rpx; margin: 0 62rpx 33rpx; background: linear-gradient(90deg, transparent, #b7bdaa 18%, #b7bdaa 82%, transparent); }
.ink-diamond { position: absolute; left: 50%; top: -5rpx; width: 10rpx; height: 10rpx; background: var(--green); transform: translateX(-50%) rotate(45deg); }
.candidate-meaning { display: -webkit-box; overflow: hidden; color: #3d5546; font-size: 29rpx; line-height: 1.85; letter-spacing: 1rpx; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.tags { height: 61rpx; overflow: hidden; margin-top: 17rpx; }
.tag { display: inline-block; margin: 0 12rpx 10rpx 0; padding: 7rpx 14rpx; border: 1rpx solid #d9dece; border-radius: 6rpx; color: #68785f; background: #f1f2e8; font-size: 20rpx; }
.source-line { margin-top: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7d8978; font-size: 22rpx; }
.detail-link { display: flex; align-items: center; margin-top: 18rpx; padding-top: 19rpx; border-top: 1rpx solid #e4e5d9; color: var(--green); font-size: 23rpx; }
.inline-icon { width: 27rpx; height: 27rpx; margin-right: 10rpx; }
.arrow { margin-left: auto; font-size: 35rpx; line-height: 1; }

.decision { position: absolute; z-index: 5; top: 60rpx; padding: 10rpx 17rpx; border: 5rpx double currentColor; border-radius: 7rpx; font: 700 31rpx/1 "PingFang SC", "Microsoft YaHei", sans-serif; letter-spacing: 5rpx; pointer-events: none; }
.decision-skip { right: 35rpx; color: var(--vermillion); transform: rotate(12deg); }
.decision-like { left: 35rpx; color: var(--green); transform: rotate(-12deg); }

.deck-empty { height: 700rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #cfd4c4; border-radius: 34rpx; color: #667462; background: rgba(255, 253, 247, .52); }
.empty-title { margin-top: 24rpx; color: #425647; font: 600 32rpx/1.5 "Songti SC", "STSong", serif; letter-spacing: 3rpx; }
.empty-copy { margin-top: 10rpx; color: #859081; font-size: 23rpx; }
.loading-mark { display: flex; align-items: center; gap: 12rpx; height: 30rpx; }
.loading-mark view { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--green); animation: pulse 1.1s ease-in-out infinite; }
.loading-mark view:nth-child(2) { animation-delay: 140ms; }
.loading-mark view:nth-child(3) { animation-delay: 280ms; }
@keyframes pulse { 0%, 80%, 100% { opacity: .24; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-9rpx); } }
.retry-button { margin-top: 30rpx; padding: 0 38rpx; border: 1rpx solid #bcc6b6; border-radius: 999rpx; color: var(--green); background: transparent; font-size: 24rpx; line-height: 68rpx; }
.retry-button::after { border: 0; }

.action-bar { height: 116rpx; display: flex; align-items: flex-start; justify-content: center; gap: 30rpx; margin-top: -27rpx; position: relative; z-index: 6; }
.action-wrap { width: 86rpx; flex: none; display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: #7a8577; font-size: 19rpx; letter-spacing: 2rpx; }
.action-button { width: 86rpx; min-width: 86rpx; max-width: 86rpx; height: 86rpx; flex: none; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: #fffdf7; box-shadow: 0 9rpx 25rpx rgba(51, 70, 56, .13); line-height: 1; }
.action-button::after { border: 0; }
.action-button image { width: 39rpx; height: 39rpx; }
.action-button[disabled] { opacity: .56; }
.action-skip { border: 1rpx solid rgba(182, 92, 72, .35); }
.action-like { border: 1rpx solid rgba(45, 89, 72, .35); }
.gesture-hint { display: flex; align-items: center; gap: 10rpx; margin-top: 30rpx; color: #9aa294; font-size: 18rpx; letter-spacing: 2rpx; }
.hint-line { width: 28rpx; height: 1rpx; background: #c4c9bc; }
.error-toast { position: fixed; z-index: 20; left: 50%; bottom: 150rpx; width: 590rpx; transform: translateX(-50%); padding: 18rpx 24rpx; border-radius: 12rpx; color: #fffaf2; background: rgba(121, 65, 50, .94); box-shadow: 0 8rpx 25rpx rgba(70, 39, 31, .18); text-align: center; font-size: 23rpx; }
.disclaimer { margin-top: -3rpx; text-align: center; color: #989f92; font-size: 18rpx; line-height: 1.5; }

@media (max-height: 700px) {
  .deck { height: 680rpx; }
  .name-card, .deck-empty { height: 630rpx; }
  .name-block { padding: 34rpx 0 25rpx; }
  .candidate-name { font-size: 84rpx; }
  .candidate-meaning { -webkit-line-clamp: 2; }
  .action-bar { margin-top: -75rpx; }
}
