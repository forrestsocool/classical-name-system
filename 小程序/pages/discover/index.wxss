.discover-page {
  --paper: #f7f5ee;
  --card: #fffefa;
  --ink: #0b4b43;
  --green: #0b584b;
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(117rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: var(--paper);
}

/* The brand shares the native navigation row instead of occupying a banner. */
.hero-landscape { position: absolute; z-index: 0; left: 0; width: 100%; height: 235rpx; opacity: .68; pointer-events: none; }
.footer-landscape { position: absolute; z-index: 0; left: 0; bottom: calc(105rpx + env(safe-area-inset-bottom)); width: 100%; height: 128rpx; pointer-events: none; }
.hero { position: relative; z-index: 1; flex: none; display: flex; align-items: flex-end; padding: 0 32rpx 8px; }
.brand-row { display: flex; align-items: center; }
.brand-name { color: #315c50; font-weight: 600; font-size: 42rpx; line-height: 43rpx; letter-spacing: 3rpx; }
.brand-seal { width: 23rpx; height: 43rpx; margin-left: 12rpx; padding: 2rpx 0; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1rpx solid #be7768; border-radius: 3rpx; color: #be7768; font-weight: 400; font-size: 12rpx; line-height: 1; }
.brand-seal text { display: block; flex: none; width: 100%; height: 12rpx; line-height: 12rpx; text-align: center; }
.brand-copy { position: relative; z-index: 1; flex: none; margin: 0 32rpx 4rpx; }
.brand-subtitle { color: #618176; font-weight: 400; font-size: 22rpx; line-height: 1.5; letter-spacing: 3rpx; }
.brand-motto { width: 328rpx; margin: 6rpx 0 0 16rpx; display: flex; align-items: center; gap: 14rpx; color: #8b9b91; font-weight: 400; font-size: 18rpx; line-height: 1.4; letter-spacing: 4rpx; }
.brand-motto view { flex: 1; height: 1rpx; background: #bccbc0; }
.brand-motto text { flex: none; }

.filters { flex: none; position: relative; z-index: 8; margin: 68rpx 28rpx 0; height: 76rpx; display: flex; align-items: stretch; gap: 14rpx; }
.filter-control { height: 76rpx; display: flex; align-items: center; border: 1rpx solid #e2e6dc; border-radius: 15rpx; background: rgba(255, 254, 250, .65); }
.surname-control { flex: 1; min-width: 0; padding: 0 18rpx; }
.filter-label { flex: none; color: #687a70; font-size: 23rpx; }
.surname-input { flex: 1; min-width: 0; margin-left: 12rpx; color: var(--green); font-size: 24rpx; }
.input-placeholder { color: #9ba69c; }
.gender-picker { width: 190rpx; flex: none; }
.gender-control { justify-content: center; gap: 10rpx; color: #425e51; font-size: 24rpx; }
.gender-control image { width: 27rpx; height: 27rpx; }
.chevron { width: 9rpx; height: 9rpx; margin-left: 5rpx; border-right: 2rpx solid #7c8a7f; border-bottom: 2rpx solid #7c8a7f; transform: rotate(45deg) translateY(-3rpx); }
.length-switch { width: 210rpx; flex: none; display: flex; padding: 6rpx; border-radius: 15rpx; background: #e9eee4; }
.length-option { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 11rpx; color: #819080; font-size: 23rpx; transition: color 180ms ease, background 180ms ease; }
.length-option.is-active { color: #245e4d; background: #fffefa; box-shadow: 0 2rpx 8rpx rgba(45, 70, 49, .08); }

/* A bounded flexible deck keeps every action visible, including on short phones. */
.deck { position: relative; flex: 1; min-height: 440rpx; max-height: 840rpx; margin: 24rpx 28rpx 38rpx; }
.name-card { position: absolute; inset: 0; border-radius: 26rpx; transform-origin: 50% 92%; }
.card-shadow { border: 1rpx solid #dfe5d9; background: #fffdf8; box-shadow: 0 7rpx 16rpx rgba(45, 63, 54, .065); pointer-events: none; }
.card-third { top: 28rpx; bottom: -28rpx; left: 30rpx; right: 24rpx; opacity: .7; transform: rotate(-1.5deg); }
.card-next { top: 14rpx; bottom: -14rpx; left: 12rpx; right: 10rpx; opacity: .88; transform: rotate(1.1deg); transition: transform 180ms ease, opacity 180ms ease; }
.next-name { margin-top: 47rpx; text-align: center; color: rgba(24, 75, 65, .14); font-weight: 600; font-size: 84rpx; line-height: 1.2; letter-spacing: 9rpx; }
.card-current { z-index: 3; display: flex; flex-direction: column; padding: 58rpx 40rpx 30rpx; border: 1rpx solid rgba(75, 94, 77, .12); overflow: hidden; background: var(--card); box-shadow: 0 14rpx 36rpx rgba(45, 63, 54, .09), 0 2rpx 7rpx rgba(53, 70, 56, .04); will-change: transform; }
.card-current::after { content: ""; position: absolute; inset: 12rpx; border: 1rpx solid rgba(75, 101, 89, .045); border-radius: 19rpx; pointer-events: none; }
.card-landscape { position: absolute; z-index: 0; left: -28rpx; bottom: 42rpx; width: 340rpx; height: 200rpx; opacity: .42; pointer-events: none; }
.bamboo { position: absolute; z-index: 1; top: -5rpx; right: -5rpx; width: 110rpx; height: 230rpx; opacity: .55; pointer-events: none; }
.card-heading, .card-story, .card-footer { position: relative; z-index: 2; }
.card-heading { flex: none; }
.name-block { text-align: center; }
.candidate-name { overflow: hidden; color: #064a40; font-weight: 700; font-size: 100rpx; line-height: 1.18; letter-spacing: 10rpx; text-indent: 10rpx; white-space: nowrap; }
.candidate-name-long { font-size: 86rpx; letter-spacing: 6rpx; text-indent: 6rpx; }
.candidate-pinyin { margin-top: 8rpx; color: #78867d; font-size: 23rpx; line-height: 1.4; letter-spacing: 6rpx; text-transform: lowercase; }
.gender-scores { height: 44rpx; margin-top: 20rpx; display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.score-pill { height: 44rpx; padding: 0 17rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border-radius: 999rpx; font-size: 22rpx; }
.score-pill image { width: 25rpx; height: 25rpx; }
.score-male { color: #3673b4; background: #f0f7fc; }
.score-female { color: #ac6270; background: #fcf1f2; }
.score-divider { width: 1rpx; height: 23rpx; background: #e0e4dc; }

/* Give meaning a place of its own, with provenance anchoring the bottom edge. */
.card-story { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; padding: 24rpx 0; }
.candidate-meaning { flex: none; display: -webkit-box; overflow: hidden; color: #3c5147; text-align: center; font-weight: 400; font-size: 29rpx; line-height: 1.85; letter-spacing: .5rpx; -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
.tags { flex: none; display: flex; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 12rpx; overflow: hidden; margin-top: 24rpx; }
.tag { flex: 0 1 auto; min-width: 0; margin: 0; padding: 8rpx 16rpx; border-radius: 999rpx; color: #52715c; background: #eff4ea; font-size: 21rpx; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card-footer { flex: none; min-height: 58rpx; padding-top: 18rpx; border-top: 1rpx solid #e8ece2; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-source { flex: 1; min-width: 0; display: flex; align-items: center; gap: 9rpx; color: #889482; font-size: 21rpx; }
.card-source image { flex: none; width: 25rpx; height: 25rpx; opacity: .55; }
.card-source > text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-detail { flex: none; margin-left: auto; display: flex; align-items: center; gap: 8rpx; color: #54765e; font-size: 21rpx; line-height: 40rpx; }
.card-detail image { width: 25rpx; height: 25rpx; }
.card-seal { position: absolute; right: 16rpx; bottom: 102rpx; width: 25rpx; height: 30rpx; border: 1rpx solid #e2a49a; border-radius: 3rpx; color: #d89487; text-align: center; font-weight: 400; font-size: 16rpx; line-height: 28rpx; opacity: .7; }
.decision { position: absolute; z-index: 7; top: 36rpx; padding: 10rpx 15rpx; border: 5rpx double currentColor; border-radius: 7rpx; font-weight: 700; font-size: 28rpx; line-height: 1; letter-spacing: 3rpx; pointer-events: none; }
.decision-skip { right: 32rpx; color: #b96156; transform: rotate(11deg); }
.decision-like { left: 32rpx; color: #0b6855; transform: rotate(-11deg); }

.deck-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #cbd2c9; border-radius: 26rpx; color: #66746f; background: rgba(255, 254, 250, .62); }
.empty-title { margin-top: 24rpx; color: #31534b; font-weight: 600; font-size: 31rpx; line-height: 1.5; letter-spacing: 3rpx; }
.empty-copy { margin-top: 10rpx; color: #85908c; font-size: 23rpx; }
.loading-mark { display: flex; align-items: center; gap: 12rpx; height: 30rpx; }
.loading-mark view { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--green); animation: pulse 1.1s ease-in-out infinite; }
.loading-mark view:nth-child(2) { animation-delay: 140ms; }
.loading-mark view:nth-child(3) { animation-delay: 280ms; }
@keyframes pulse { 0%, 80%, 100% { opacity: .24; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-9rpx); } }
.retry-button { margin-top: 30rpx; padding: 0 38rpx; border: 1rpx solid #b8c3bb; border-radius: 999rpx; color: var(--green); background: transparent; font-size: 24rpx; line-height: 68rpx; }
.retry-button::after { border: 0; }

.action-bar { flex: none; height: 140rpx; display: flex; align-items: center; justify-content: center; gap: 62rpx; position: relative; z-index: 6; }
.action-wrap { width: 100rpx; flex: none; display: flex; flex-direction: column; align-items: center; gap: 9rpx; color: #567060; font-size: 21rpx; }
.action-button { width: 100rpx; min-width: 100rpx; max-width: 100rpx; height: 100rpx; flex: none; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: #fffefa; box-shadow: 0 7rpx 19rpx rgba(45, 62, 54, .09); line-height: 1; }
.action-button::after { border: 0; }
.action-button image { width: 41rpx; height: 41rpx; }
.action-button[disabled] { opacity: .56; }
.action-skip, .action-favorite { border: 1rpx solid #e7ebe2; }
.action-next { border: 0; background: #0b584b; box-shadow: 0 7rpx 19rpx rgba(11, 88, 75, .18); }
.error-toast { position: fixed; z-index: 20; left: 50%; bottom: calc(180rpx + env(safe-area-inset-bottom)); width: 590rpx; transform: translateX(-50%); padding: 18rpx 24rpx; border-radius: 13rpx; color: #fffaf2; background: rgba(121, 65, 50, .94); text-align: center; font-size: 23rpx; }

@media (max-height: 730px) {
  .filters { margin-top: 40rpx; }
  .card-current { padding-top: 44rpx; padding-bottom: 24rpx; }
  .candidate-name { font-size: 92rpx; }
  .candidate-name-long { font-size: 80rpx; }
  .gender-scores { margin-top: 14rpx; }
  .candidate-meaning { font-size: 28rpx; line-height: 1.75; -webkit-line-clamp: 3; }
  .card-story { padding: 18rpx 0; }
  .tags { margin-top: 18rpx; }
}
@media (max-height: 620px) {
  .filters { margin-top: 28rpx; }
  .deck { min-height: 430rpx; margin-top: 18rpx; margin-bottom: 32rpx; }
  .card-current { padding-top: 30rpx; padding-bottom: 20rpx; }
  .candidate-name { font-size: 84rpx; }
  .candidate-name-long { font-size: 74rpx; }
  .candidate-pinyin { margin-top: 4rpx; font-size: 21rpx; }
  .gender-scores { margin-top: 10rpx; }
  .card-story { padding: 12rpx 0; }
  .candidate-meaning { -webkit-line-clamp: 2; }
  .tags { margin-top: 12rpx; }
  .card-footer { min-height: 50rpx; padding-top: 12rpx; }
  .action-bar { height: 128rpx; }
  .action-button { width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; }
}
