.discover-page {
  --paper: #f7f5ee;
  --card: #fffefa;
  --ink: #0b4b43;
  --green: #0b584b;
  --muted: #73817b;
  min-height: 100vh;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: radial-gradient(circle at 80% 13%, rgba(238, 187, 135, .12), transparent 24%), #f7f5ee;
}

.hero { position: relative; height: 285rpx; padding: 22rpx 54rpx 0; overflow: hidden; }
.hero-landscape { position: absolute; z-index: 0; left: 0; right: 0; bottom: -2rpx; width: 100%; height: 285rpx; pointer-events: none; }
.brand-row, .brand-subtitle, .brand-motto { position: relative; z-index: 1; }
.brand-row { display: flex; align-items: center; }
.brand-name { color: #094940; font: 700 66rpx/1.06 serif; letter-spacing: 9rpx; }
.brand-seal { width: 34rpx; height: 52rpx; margin-left: 14rpx; padding: 3rpx 1rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 2rpx solid #c95648; border-radius: 5rpx; color: #c95648; background: rgba(255, 254, 250, .62); font: 500 16rpx/1.15 serif; transform: rotate(-2deg); }
.brand-subtitle { margin: 11rpx 0 0 4rpx; color: #2a625a; font: 400 24rpx/1.5 serif; letter-spacing: 6rpx; }
.brand-motto { width: 332rpx; margin: 9rpx 0 0 42rpx; display: flex; align-items: center; gap: 16rpx; color: #7d8b85; font-size: 18rpx; letter-spacing: 4rpx; }
.brand-motto view { flex: 1; height: 1rpx; background: #9bacaa; }

.filters { position: relative; z-index: 8; margin: -1rpx 24rpx 0; height: 88rpx; padding: 8rpx; display: flex; align-items: stretch; gap: 10rpx; border: 1rpx solid rgba(111, 128, 120, .16); border-radius: 20rpx; background: rgba(255, 254, 250, .96); box-shadow: 0 7rpx 24rpx rgba(53, 78, 67, .06); }
.filter-control { height: 70rpx; display: flex; align-items: center; border: 1rpx solid #e2e4de; border-radius: 14rpx; background: rgba(255,255,255,.76); }
.surname-control { width: 220rpx; padding: 0 15rpx; }
.filter-label { flex: none; color: #334c48; font-size: 25rpx; }
.surname-input { width: 116rpx; margin-left: 12rpx; color: var(--green); font-size: 25rpx; }
.input-placeholder { color: #a4aaa8; }
.gender-picker { width: 192rpx; }
.gender-control { width: 192rpx; justify-content: center; gap: 10rpx; color: #263f3b; font-size: 25rpx; }
.gender-control image { width: 30rpx; height: 30rpx; }
.chevron { width: 10rpx; height: 10rpx; margin-left: 3rpx; border-right: 3rpx solid #64736e; border-bottom: 3rpx solid #64736e; transform: rotate(45deg) translateY(-4rpx); }
.length-switch { flex: 1; display: flex; padding: 4rpx; border: 1rpx solid #e2e4de; border-radius: 14rpx; background: rgba(255,255,255,.76); }
.length-option { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #4b5854; font-size: 24rpx; transition: color 180ms ease, background 180ms ease; }
.length-option.is-active { color: #fffefa; background: linear-gradient(145deg, #18705e, #0b584b); box-shadow: 0 5rpx 13rpx rgba(11, 88, 75, .24); }

.deck { position: relative; height: 760rpx; margin: 35rpx 35rpx 0; }
.name-card { position: absolute; left: 0; right: 0; top: 0; height: 710rpx; border-radius: 26rpx; transform-origin: 50% 92%; }
.card-shadow { border: 1rpx solid rgba(65, 83, 75, .1); background: #fffdf8; pointer-events: none; }
.card-third { top: -28rpx; left: 42rpx; right: 42rpx; opacity: .55; transform: rotate(-1.3deg); }
.card-next { top: -14rpx; left: 20rpx; right: 20rpx; opacity: .78; transform: rotate(1.2deg); transition: transform 180ms ease, opacity 180ms ease; }
.next-name { margin-top: 90rpx; text-align: center; color: rgba(24, 75, 65, .14); font: 600 60rpx/1.2 serif; letter-spacing: 12rpx; }
.card-current { z-index: 3; display: flex; flex-direction: column; align-items: stretch; padding: 66rpx 46rpx 37rpx; border: 1rpx solid rgba(75, 94, 77, .12); overflow: hidden; background: rgba(255, 254, 250, .98); box-shadow: 0 25rpx 58rpx rgba(45, 63, 54, .15), 0 3rpx 9rpx rgba(53, 70, 56, .07); will-change: transform; }
.card-current::after { content: ""; position: absolute; inset: 16rpx; border: 1rpx solid rgba(75, 101, 89, .05); border-radius: 19rpx; pointer-events: none; }
.card-landscape { position: absolute; z-index: 0; left: -8rpx; top: 24rpx; width: 360rpx; height: 214rpx; pointer-events: none; }
.bamboo { position: absolute; z-index: 1; top: -5rpx; right: -5rpx; width: 142rpx; height: 300rpx; opacity: .84; pointer-events: none; }
.name-block, .gender-scores, .candidate-meaning, .tags, .card-seal { position: relative; z-index: 2; }
.name-block { padding-top: 5rpx; text-align: center; }
.candidate-name { overflow: hidden; color: #064a40; font: 700 94rpx/1.13 serif; letter-spacing: 15rpx; text-indent: 15rpx; white-space: nowrap; }
.candidate-pinyin { margin-top: 5rpx; color: #516a67; font-size: 24rpx; letter-spacing: 10rpx; text-transform: lowercase; }
.gender-scores { height: 58rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; gap: 19rpx; }
.score-pill { min-width: 150rpx; height: 58rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: center; gap: 11rpx; border-radius: 999rpx; font-size: 25rpx; }
.score-pill image { width: 30rpx; height: 30rpx; }
.score-male { color: #2467b8; background: #edf6ff; }
.score-female { color: #a94854; background: #fff0f1; }
.score-divider { width: 1rpx; height: 31rpx; background: #d6dcd8; }
.candidate-meaning { margin-top: 26rpx; display: -webkit-box; overflow: hidden; color: #314a46; text-align: center; font: 400 28rpx/1.85 serif; letter-spacing: 1rpx; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.tags { height: 58rpx; overflow: hidden; margin-top: 18rpx; text-align: center; white-space: nowrap; }
.tag { display: inline-block; margin: 0 7rpx; padding: 9rpx 19rpx; border-radius: 999rpx; color: #2c6658; background: #edf4eb; font-size: 22rpx; }
.card-seal { position: absolute; right: 18rpx; bottom: 14rpx; width: 28rpx; height: 35rpx; border: 2rpx solid #e2a49a; border-radius: 3rpx; color: #d89487; text-align: center; font: 18rpx/31rpx serif; }
.decision { position: absolute; z-index: 7; top: 48rpx; padding: 10rpx 15rpx; border: 5rpx double currentColor; border-radius: 7rpx; font: 700 28rpx/1 sans-serif; letter-spacing: 3rpx; pointer-events: none; }
.decision-skip { right: 32rpx; color: #b96156; transform: rotate(11deg); }
.decision-like { left: 32rpx; color: #0b6855; transform: rotate(-11deg); }

.deck-empty { height: 710rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #cbd2c9; border-radius: 26rpx; color: #66746f; background: rgba(255, 254, 250, .62); }
.empty-title { margin-top: 24rpx; color: #31534b; font: 600 31rpx/1.5 serif; letter-spacing: 3rpx; }
.empty-copy { margin-top: 10rpx; color: #85908c; font-size: 23rpx; }
.loading-mark { display: flex; align-items: center; gap: 12rpx; height: 30rpx; }
.loading-mark view { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--green); animation: pulse 1.1s ease-in-out infinite; }
.loading-mark view:nth-child(2) { animation-delay: 140ms; }
.loading-mark view:nth-child(3) { animation-delay: 280ms; }
@keyframes pulse { 0%, 80%, 100% { opacity: .24; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-9rpx); } }
.retry-button { margin-top: 30rpx; padding: 0 38rpx; border: 1rpx solid #b8c3bb; border-radius: 999rpx; color: var(--green); background: transparent; font-size: 24rpx; line-height: 68rpx; }
.retry-button::after { border: 0; }

.action-bar { height: 142rpx; display: flex; align-items: flex-start; justify-content: center; gap: 62rpx; margin-top: -8rpx; position: relative; z-index: 6; }
.action-wrap { width: 100rpx; flex: none; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #235b50; font-size: 22rpx; }
.action-button { width: 100rpx; min-width: 100rpx; max-width: 100rpx; height: 100rpx; flex: none; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: #fffefa; box-shadow: 0 11rpx 27rpx rgba(45, 62, 54, .13); line-height: 1; }
.action-button::after { border: 0; }
.action-button image { width: 43rpx; height: 43rpx; }
.action-button[disabled] { opacity: .56; }
.action-skip { border: 1rpx solid #edf0ed; }
.action-favorite { border: 1rpx solid #edf0ed; }
.action-next { border: 0; background: linear-gradient(145deg, #237460, #075244); box-shadow: 0 13rpx 30rpx rgba(11, 88, 75, .25); }
.error-toast { position: fixed; z-index: 20; left: 50%; bottom: 174rpx; width: 590rpx; transform: translateX(-50%); padding: 18rpx 24rpx; border-radius: 13rpx; color: #fffaf2; background: rgba(121, 65, 50, .94); text-align: center; font-size: 23rpx; }
.disclaimer { margin-top: -2rpx; text-align: center; color: #9aa39f; font-size: 18rpx; line-height: 1.5; }

@media (max-height: 730px) {
  .hero { height: 203rpx; padding-top: 20rpx; }
  .brand-name { font-size: 58rpx; }
  .brand-motto { display: none; }
  .deck { height: 620rpx; margin-top: 27rpx; }
  .name-card, .deck-empty { height: 575rpx; }
  .card-current { padding-top: 48rpx; }
  .candidate-name { font-size: 84rpx; }
  .candidate-meaning { -webkit-line-clamp: 2; }
  .action-bar { margin-top: -4rpx; }
}
