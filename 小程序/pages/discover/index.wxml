<view class="discover-page" style="padding-top:{{statusBarHeight}}px">
  <image class="hero-landscape" style="top:{{statusBarHeight - 12}}px" src="/assets/landscape.svg" mode="aspectFill" aria-hidden="true" />
  <image class="footer-landscape" src="/assets/footer-mountains.svg" mode="scaleToFill" aria-hidden="true" />
  <view class="hero" style="height:{{navHeight}}px">
    <view class="brand-row">
      <view class="brand-name">好名千寻</view>
      <view class="brand-seal">隽<text>名</text></view>
    </view>
  </view>

  <view class="filters">
    <view class="filter-control surname-control">
      <text class="filter-label">姓氏</text>
      <input class="surname-input" value="{{surname}}" maxlength="2" placeholder="选填" placeholder-class="input-placeholder" bindinput="onSurnameInput" />
    </view>
    <picker class="gender-picker" mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="genderChange">
      <view class="filter-control gender-control">
        <image src="/assets/icons/{{genderIcon}}.svg" mode="aspectFit" />
        <text>{{genderLabel}}</text>
        <view class="chevron"></view>
      </view>
    </picker>
    <view class="length-switch" aria-label="名字字数">
      <view class="length-option {{nameLength === 1 ? 'is-active' : ''}}" data-length="1" bindtap="lengthChange">单字</view>
      <view class="length-option {{nameLength === 2 ? 'is-active' : ''}}" data-length="2" bindtap="lengthChange">双字</view>
    </view>
  </view>

  <view class="deck" wx:if="{{ready}}">
    <view class="name-card card-shadow card-third" wx:if="{{current}}"></view>
    <view class="name-card card-shadow card-next" style="{{stackStyle}}" wx:if="{{next}}">
      <view class="next-name">{{next.item.displayName}}</view>
    </view>
    <view
      class="name-card card-current"
      style="{{cardStyle}}"
      wx:if="{{current}}"
      bindtouchstart="touchStart"
      catchtouchmove="touchMove"
      bindtouchend="touchEnd"
      bindtouchcancel="touchCancel"
      catchtap="detail"
    >
      <image class="card-landscape" src="/assets/card-landscape.svg" mode="aspectFit" />
      <image class="bamboo" src="/assets/bamboo.svg" mode="aspectFit" />
      <view class="decision decision-skip" style="opacity:{{skipOpacity}}">不喜欢</view>
      <view class="decision decision-like" style="opacity:{{likeOpacity}}">收藏</view>
      <view class="card-heading">
        <view class="name-block">
          <view class="candidate-name {{current.item.displayName.length > 3 ? 'candidate-name-long' : ''}}">{{current.item.displayName}}</view>
          <view class="candidate-pinyin">{{current.item.pinyin}}</view>
        </view>
        <view class="gender-scores">
          <view class="score-pill score-male"><image src="/assets/icons/male.svg" mode="aspectFit" /><text>{{current.item.maleScore}}%</text></view>
          <view class="score-divider"></view>
          <view class="score-pill score-female"><image src="/assets/icons/female.svg" mode="aspectFit" /><text>{{current.item.femaleScore}}%</text></view>
        </view>
      </view>
      <view class="card-story">
        <view class="candidate-meaning">{{current.item.meaning}}</view>
        <view class="tags" wx:if="{{current.item.tags.length}}">
          <text class="tag" wx:for="{{current.item.tags}}" wx:key="*this" wx:if="{{index < 3}}">{{item}}</text>
        </view>
      </view>
      <view class="card-footer">
        <view class="card-source" wx:if="{{current.item.book}}">
          <image src="/assets/icons/book-open.svg" mode="aspectFit" />
          <text>《{{current.item.book}}》<text wx:if="{{current.item.chapter}}"> · {{current.item.chapter}}</text></text>
        </view>
        <view class="card-detail" catchtap="detail" role="button" aria-label="查看名字的出处与释义">
          <text>查看出处</text><image src="/assets/icons/arrow-right-green.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="card-seal">寻</view>
    </view>

    <view class="deck-empty" wx:else>
      <view class="loading-mark" wx:if="{{loading}}"><view></view><view></view><view></view></view>
      <view class="empty-title">{{loading ? '正在翻阅典籍' : '这一叠已经看完'}}</view>
      <view class="empty-copy" wx:if="{{!loading}}">{{cooldown > 0 ? cooldown + ' 秒后继续送来新名字' : '可换一种筛选，或稍后再来'}}</view>
      <button class="retry-button" wx:if="{{!loading}}" disabled="{{cooldown > 0}}" bindtap="retry">{{cooldown > 0 ? '稍候片刻' : '再寻一叠'}}</button>
    </view>
  </view>

  <view class="deck deck-loading" wx:else>
    <view class="deck-empty"><view class="loading-mark"><view></view><view></view><view></view></view><view class="empty-title">正在进入好名千寻</view></view>
  </view>

  <view class="action-bar" wx:if="{{current}}">
    <view class="action-wrap">
      <button class="action-button action-skip" disabled="{{animating}}" bindtap="skip" aria-label="不喜欢这个名字">
        <image src="/assets/icons/x.svg" mode="aspectFit" />
      </button>
      <text>不喜欢</text>
    </view>
    <view class="action-wrap">
      <button class="action-button action-favorite" loading="{{saving}}" disabled="{{animating}}" bindtap="favorite" aria-label="收藏这个名字">
        <image src="/assets/icons/star.svg" mode="aspectFit" />
      </button>
      <text>收藏</text>
    </view>
    <view class="action-wrap">
      <button class="action-button action-next" disabled="{{animating}}" bindtap="next" aria-label="查看下一个名字">
        <image src="/assets/icons/arrow-right.svg" mode="aspectFit" />
      </button>
      <text>下一个</text>
    </view>
  </view>

  <view class="error-toast" wx:if="{{error}}" bindtap="retry">{{error}}</view>
  <view class="disclaimer">左右滑动：左边略过，右边收藏</view>
</view>
