.favorites-page {
  min-height: 100vh;
  padding: 14rpx 28rpx calc(145rpx + env(safe-area-inset-bottom));
  color: #314a46;
  background: #f7f5ee;
  overflow-x: hidden;
}
.collection-hint { height: 66rpx; margin: 0 28rpx 14rpx; display: flex; align-items: center; justify-content: center; gap: 20rpx; color: #8a9790; font-size: 21rpx; letter-spacing: 2rpx; }
.hint-line { width: 53rpx; height: 1rpx; background: #d7dfd6; }
.favorite-row { position: relative; margin-bottom: 25rpx; border-radius: 24rpx; overflow: hidden; background: #f2e6df; box-shadow: 0 12rpx 32rpx rgba(45, 63, 54, .07), 0 2rpx 7rpx rgba(53, 70, 56, .025); }
.favorite-card { position: relative; z-index: 1; width: 100%; padding: 32rpx 30rpx 24rpx; border: 1rpx solid #e6e8df; border-radius: 24rpx; background: #fffefa; overflow: hidden; transition: transform 230ms cubic-bezier(.2,.8,.2,1); }
.favorite-card.is-dragging { transition: none; }
.card-mountains { position: absolute; left: -15rpx; top: 22rpx; width: 320rpx; height: 190rpx; opacity: .55; pointer-events: none; }
.favorite-top, .mini-scores, .favorite-meaning, .favorite-tags, .favorite-source { position: relative; z-index: 1; }
.favorite-top { display: flex; flex-direction: column; align-items: stretch; gap: 18rpx; }
.name-group { min-width: 0; width: 100%; }
.favorite-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }
.favorite-share-button { flex: none; width: 76rpx; height: 61rpx; margin: 0; padding: 0; border: 1rpx solid #dce6da; border-radius: 999rpx; color: #0b584b; background: #f0f5ed; font-size: 22rpx; line-height: 59rpx; }
.favorite-share-button::after { border: 0; }
.favorite-share-button[disabled] { opacity: .55; }
.favorite-name { color: #094e43; font-weight: 600; font-size: 55rpx; line-height: 1.2; letter-spacing: 7rpx; white-space: nowrap; }
.favorite-pinyin { margin-top: 9rpx; color: #7e8c87; font-size: 20rpx; line-height: 1.5; letter-spacing: 4rpx; word-break: break-word; }
.source-button { flex: none; display: flex; align-items: center; justify-content: center; gap: 10rpx; width: 188rpx; min-width: 188rpx; max-width: 188rpx; height: 61rpx; margin: 0; padding: 0 17rpx; border: 1rpx solid #dce6da; border-radius: 999rpx; color: #0b584b; background: #f0f5ed; font-size: 22rpx; font-weight: 400; line-height: 1; }
.source-button image { width: 27rpx; height: 27rpx; }
.source-button::after, .remove-button::after, .discover-button::after { border: 0; }
.source-button[disabled] { color: #7d9184; opacity: .55; }
.mini-scores { display: flex; gap: 12rpx; margin-top: 21rpx; }
.mini-score { display: flex; align-items: center; gap: 7rpx; height: 41rpx; padding: 0 13rpx; border-radius: 999rpx; font-size: 20rpx; }
.mini-score image { width: 23rpx; height: 23rpx; }
.mini-male { color: #2467b8; background: #edf6ff; }
.mini-female { color: #a94854; background: #fff0f1; }
.favorite-meaning { display: -webkit-box; overflow: hidden; margin-top: 20rpx; color: #435b51; font-weight: 400; font-size: 27rpx; line-height: 1.85; letter-spacing: .5rpx; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.favorite-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.favorite-tags text { display: block; padding: 7rpx 16rpx; border-radius: 999rpx; color: #3c6b59; background: #edf4eb; font-size: 20rpx; line-height: 1.4; }
.favorite-source { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 23rpx; padding-top: 17rpx; border-top: 1rpx solid #eef0e8; color: #87938b; font-size: 21rpx; line-height: 1.6; }
.favorite-source image { flex: none; width: 25rpx; height: 25rpx; margin-top: 4rpx; opacity: .57; }
.favorite-source > text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.remove-button { position: absolute; z-index: 0; top: 0; right: 0; bottom: 0; width: 178rpx; min-width: 178rpx; max-width: 178rpx; height: 100%; margin: 0; padding: 0 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; border-radius: 0 24rpx 24rpx 0; color: #a45e50; background: #f2e6df; font-size: 23rpx; line-height: 1.4; }
.remove-button image { width: 43rpx; height: 43rpx; }
.remove-button[disabled] { color: #aa8a7e; background: #f2e6df; }
.collection-state { min-height: 650rpx; padding: 130rpx 20rpx 60rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-state { padding-top: 60rpx; }
.empty-art { position: relative; width: 360rpx; height: 180rpx; margin-bottom: 16rpx; }
.empty-mountains { position: absolute; inset: 0; width: 360rpx; height: 214rpx; }
.empty-heart { position: absolute; width: 63rpx; height: 63rpx; left: 149rpx; top: 65rpx; opacity: .62; }
.state-title { margin-top: 25rpx; color: #315a4b; font-weight: 400; font-size: 33rpx; line-height: 1.6; letter-spacing: 3rpx; }
.state-copy { margin-top: 12rpx; color: #8b9790; font-size: 24rpx; line-height: 1.7; }
.discover-button { display: flex; align-items: center; gap: 22rpx; margin: 36rpx 0 0; padding: 0 33rpx; border-radius: 999rpx; color: #fffefa; background: linear-gradient(145deg, #237460, #0b584b); font-size: 26rpx; line-height: 78rpx; }
.discover-button image { width: 30rpx; height: 30rpx; }
.loading-dots { display: flex; gap: 12rpx; }
.loading-dots view { width: 9rpx; height: 9rpx; border-radius: 50%; background: #467667; animation: breathe 1.2s infinite; }
.loading-dots view:nth-child(2) { animation-delay: 150ms; }
.loading-dots view:nth-child(3) { animation-delay: 300ms; }
@keyframes breathe { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }
.collection-error { margin: 15rpx 3rpx 25rpx; padding: 18rpx 22rpx; border: 1rpx solid #ead7c9; border-radius: 16rpx; color: #a0634c; background: #fbf0e7; font-size: 23rpx; line-height: 1.7; text-align: center; }
.retry-label { margin-left: 14rpx; white-space: nowrap; text-decoration: underline; }
.list-foot { padding: 19rpx 0 12rpx; color: #9aa39a; text-align: center; font-size: 21rpx; letter-spacing: 2rpx; }
