<view class="favorites-page" bindtap="closeOnTap">
  <view class="collection-hint" wx:if="{{cards.length}}">
    <view class="hint-line"></view>
    <text>左滑卡片可取消收藏</text>
    <view class="hint-line"></view>
  </view>

  <view class="collection-error" wx:if="{{error}}" catchtap="retry" role="button" aria-label="重新加载收藏">
    {{error}}<text class="retry-label">轻点重试</text>
  </view>

  <view class="collection-state" wx:if="{{!cards.length && (loading || refreshing)}}">
    <view class="loading-dots"><view></view><view></view><view></view></view>
    <view class="state-title">正在翻阅收藏</view>
  </view>
  <view class="collection-state empty-state" wx:elif="{{initialized && !cards.length && !error}}">
    <view class="empty-art">
      <image class="empty-mountains" src="/assets/card-landscape.svg" mode="aspectFit" />
      <image class="empty-heart" src="/assets/icons/heart.svg" mode="aspectFit" />
    </view>
    <view class="state-title">还没有收藏的名字</view>
    <view class="state-copy">在首页右滑，留下喜欢的名字。</view>
    <button class="discover-button" catchtap="goDiscover">去挑名字<image src="/assets/icons/arrow-right.svg" mode="aspectFit" /></button>
  </view>

  <view class="favorite-row {{openId === item.id ? 'row-open' : ''}}" wx:for="{{cards}}" wx:key="id">
    <button
      wx:if="{{openId === item.id}}"
      class="remove-button"
      data-id="{{item.id}}"
      disabled="{{loading || refreshing || removingId}}"
      loading="{{removingId === item.id}}"
      catchtap="remove"
      aria-label="取消收藏{{item.item.displayName}}"
    >
      <image wx:if="{{removingId !== item.id}}" src="/assets/icons/heart-minus.svg" mode="aspectFit" />
      <text>{{removingId === item.id ? '正在取消' : '取消收藏'}}</text>
    </button>
    <view
      class="favorite-card {{openId === item.id && dragging ? 'is-dragging' : ''}}"
      style="transform:translate3d({{openId === item.id ? slideX : 0}}px,0,0);"
      data-id="{{item.id}}"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
      bindtouchcancel="touchCancel"
    >
      <image class="card-mountains" src="/assets/favorite-landscape.svg" mode="aspectFit" />
      <view class="favorite-top">
        <view class="name-group">
          <view class="favorite-name">{{item.item.displayName}}</view>
          <view class="favorite-meta">
            <view class="favorite-pinyin">{{item.item.pinyin}}</view>
            <view class="mini-scores">
              <view class="mini-score mini-male"><image src="/assets/icons/male.svg" mode="aspectFit" /><text>{{item.item.maleScore}}%</text></view>
              <view class="mini-score mini-female"><image src="/assets/icons/female.svg" mode="aspectFit" /><text>{{item.item.femaleScore}}%</text></view>
            </view>
          </view>
        </view>
        <view class="favorite-actions">
        <button class="favorite-share-button" open-type="{{item.shareReady ? 'share' : ''}}" catchtap="prepareFavoriteShare" data-id="{{item.id}}" disabled="{{removingId}}" aria-label="分享{{item.item.name}}"><image src="/assets/icons/share-green.svg" mode="aspectFit" /><text>{{item.sharePreparing ? '准备中' : '分享'}}</text></button>
        <button class="source-button" data-id="{{item.id}}" disabled="{{removingId}}" catchtap="detail" aria-label="查看{{item.item.displayName}}的出处与释义">
          <image src="/assets/icons/document-green.svg" mode="aspectFit" /><text>查看出处</text><image class="source-arrow" src="/assets/icons/arrow-right-green.svg" mode="aspectFit" />
        </button>
        </view>
      </view>
      <view class="favorite-meaning">{{item.item.meaning}}</view>
      <view class="favorite-tags" wx:if="{{item.item.tags.length}}">
        <text wx:for="{{item.item.tags}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="*this" wx:if="{{tagIndex < 3}}">{{tag}}</text>
      </view>
      <view class="favorite-source">
        <image src="/assets/icons/book-open.svg" mode="aspectFit" />
        <text>《{{item.item.book}}》<text wx:if="{{item.item.chapter}}"> · {{item.item.chapter}}</text></text>
      </view>
    </view>
  </view>
  <view class="list-foot" wx:if="{{cards.length && !error}}">
    {{loading ? '正在翻阅收藏…' : (nextCursor ? '上拉查看更多' : '喜欢的名字，都在这里')}}
  </view>
</view>
