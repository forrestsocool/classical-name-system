<view class="favorites-page">
  <view class="favorites-head"><view class="eyebrow">把心动的名字，慢慢留下</view><view class="favorites-title">我的收藏</view><view class="muted">选中 2—4 个名字，可以放在一起比较。</view></view>
  <view class="toolbar"><button class="soft-button" loading="{{busy}}" disabled="{{busy}}" bindtap="reload">刷新收藏</button><button class="compare-button" disabled="{{busy || selectedCount < 2}}" bindtap="compare">比较 {{selectedCount || ''}}</button></view>
  <view class="muted error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{!cards.length && !busy}}">还没有收藏的名字<view class="muted">去好名千寻，留下第一份心动。</view></view>
  <view class="favorite-card" wx:for="{{cards}}" wx:key="id">
    <view class="favorite-top"><view class="favorite-name" data-id="{{item.id}}" bindtap="detail">{{item.item.displayName}}</view><view class="check {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="select">{{item.selected ? '已选择' : '选择'}}</view></view>
    <view class="favorite-pinyin">{{item.item.pinyin}}</view>
    <view class="mini-scores"><text class="mini-male">男 {{item.item.maleScore}}%</text><text class="mini-female">女 {{item.item.femaleScore}}%</text></view>
    <view class="favorite-meaning">{{item.item.meaning}}</view>
    <view class="favorite-source">《{{item.item.book}}》 · {{item.item.chapter}}</view>
    <view class="card-actions"><button data-id="{{item.id}}" bindtap="detail">查看出处</button><button data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">取消收藏</button></view>
  </view>
  <button class="more-button" wx:if="{{nextCursor}}" disabled="{{busy}}" bindtap="more">更多收藏</button>
  <view class="comparison-panel" wx:if="{{comparison.length}}">
    <view class="comparison-title">名字比较</view>
    <view class="comparison" wx:for="{{comparison}}" wx:key="id"><view class="favorite-name">{{item.item.displayName}}</view><view class="favorite-pinyin">{{item.item.pinyin}}</view><view class="favorite-meaning">{{item.item.meaning}}</view><view class="favorite-source">《{{item.item.book}}》 · {{item.item.chapter}}</view><text class="comparison-tag" wx:for="{{item.item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
  </view>
</view>
