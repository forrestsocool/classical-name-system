/* Use locally installed sans-serif fonts on every client. iOS resolves to
   PingFang, Windows to YaHei, Android to its system CJK sans-serif fallback.
   Keep headings on the same family so the IDE cannot silently show Songti. */
page { font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans CJK SC', 'Noto Sans SC', sans-serif; }
view, text, input, button { font-family: inherit; }
page { background: #f6f3eb; color: #283f34; font-size: 28rpx; }
view, text, input, button { box-sizing: border-box; }
.page { padding: 36rpx 36rpx 60rpx; }
.eyebrow { color: #8b977e; font-size: 20rpx; letter-spacing: 5rpx; }
.title { margin: 18rpx 0; font-size: 52rpx; font-weight: 600; letter-spacing: 5rpx; }
.muted { color: #7e877b; font-size: 25rpx; line-height: 1.8; }
.panel { margin: 28rpx 0; padding: 32rpx; border: 1rpx solid #e2e3d5; border-radius: 28rpx; background: #fffdf7; }
.row { display: flex; align-items: center; gap: 20rpx; }
.row-item { flex: 1; }
.button { margin-top: 20rpx; padding: 4rpx 18rpx; border-radius: 100rpx; color: #fffef4; background: #315b47; font-size: 28rpx; }
.button::after { border: 0; }
.button.secondary { color: #355643; background: #e8ebdf; }
.button[disabled] { opacity: .45; }
.input { height: 84rpx; margin: 12rpx 0 24rpx; padding: 20rpx; border-radius: 14rpx; background: #f2f3e9; font-size: 32rpx; }
.label { color: #7b8774; font-size: 24rpx; }
.name { font-weight: 600; font-size: 86rpx; line-height: 1.2; letter-spacing: 16rpx; }
.pinyin { margin: 14rpx 0 36rpx; color: #8f987e; font-size: 26rpx; letter-spacing: 4rpx; }
.meaning { color: #3c5544; font-size: 32rpx; line-height: 1.95; }
.source { margin: 28rpx 0; color: #78816f; font-size: 25rpx; line-height: 1.8; }
.tag { display: inline-block; margin: 12rpx 12rpx 0 0; padding: 8rpx 14rpx; border-radius: 8rpx; color: #697b55; background: #eef0e4; font-size: 22rpx; }
.empty { padding: 80rpx 20rpx; text-align: center; line-height: 2; }
.link { padding: 24rpx 0; color: #466e53; font-size: 26rpx; }
.quote { padding-left: 24rpx; border-left: 4rpx solid #a4b095; color: #56674e; font-size: 30rpx; line-height: 2.1; white-space: pre-wrap; }
.error { color: #9b5a45; }
.card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 40rpx; }
.section-title { margin-bottom: 24rpx; font-size: 30rpx; font-weight: 600; }
.note { margin-top: 30rpx; color: #929887; font-size: 22rpx; line-height: 1.8; }
.favorite-name { font-weight: 400; font-size: 44rpx; line-height: 1.2; letter-spacing: 8rpx; }
.check { color: #547344; }
.comparison { margin-bottom: 24rpx; }
.spacer { height: 20rpx; }
