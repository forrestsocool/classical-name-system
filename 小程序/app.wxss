page{background:#f6f3eb;color:#283f34;font-family:system-ui,-apple-system,"PingFang SC",sans-serif;font-size:28rpx}view,text,input,button{box-sizing:border-box}.page{padding:36rpx 36rpx 60rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#8b977e}.title{font-size:52rpx;font-weight:600;letter-spacing:5rpx;margin:18rpx 0}.muted{color:#7e877b;font-size:25rpx;line-height:1.8}.panel{background:#fffdf7;border:1rpx solid #e2e3d5;border-radius:28rpx;padding:32rpx;margin:28rpx 0}.row{display:flex;gap:20rpx;align-items:center}.row>*{flex:1}.button{background:#315b47;color:#fffef4;border-radius:100rpx;font-size:28rpx;padding:4rpx 18rpx;margin-top:20rpx}.button::after{border:0}.button.secondary{background:#e8ebdf;color:#355643}.button[disabled]{opacity:.45}.input{background:#f2f3e9;border-radius:14rpx;padding:20rpx;margin:12rpx 0 24rpx;font-size:32rpx;height:84rpx}.label{font-size:24rpx;color:#7b8774}.name{font-size:86rpx;letter-spacing:16rpx;font-family:"Songti SC",serif;font-weight:600}.pinyin{color:#8f987e;font-size:26rpx;letter-spacing:4rpx;margin:14rpx 0 36rpx}.meaning{font-size:32rpx;line-height:1.95;color:#3c5544}.source{color:#78816f;font-size:25rpx;line-height:1.8;margin:28rpx 0}.tag{display:inline-block;background:#eef0e4;color:#697b55;border-radius:8rpx;padding:8rpx 14rpx;font-size:22rpx;margin:12rpx 12rpx 0 0}.empty{text-align:center;padding:80rpx 20rpx;line-height:2}.link{color:#466e53;font-size:26rpx;padding:24rpx 0}.quote{border-left:4rpx solid #a4b095;padding-left:24rpx;line-height:2.1;font-size:30rpx;color:#56674e;white-space:pre-wrap}.error{color:#9b5a45}.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:40rpx}.section-title{font-size:30rpx;font-weight:600;margin-bottom:24rpx}.note{font-size:22rpx;color:#929887;line-height:1.8;margin-top:30rpx}.favorite-name{font-size:44rpx;letter-spacing:8rpx;font-family:"Songti SC",serif}.check{color:#547344}.comparison{margin-bottom:24rpx}.spacer{height:20rpx}
